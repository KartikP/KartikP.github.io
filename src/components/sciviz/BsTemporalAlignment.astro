---
// BsTemporalAlignment — combines the multi-tower model architecture
// with the temporal-alignment problem in one diagram. Three towers
// (vision, audio, text) emit features at different native rates over a
// shared timeline; vertical TR ticks mark the brain's recording grid;
// a hemodynamic-response curve shows how predicted features get
// time-shifted before being compared with BOLD activity. A draggable
// HRF-delay slider lets the reader sweep the predicted-signal offset
// from 0–10 s.

interface Props {
  caption?: string;
}
const { caption } = Astro.props;
const uid = "bta-" + Math.random().toString(36).slice(2, 8);
---

<figure class="bta-figure" data-uid={uid}>
  <div class="bta-frame">
    <svg viewBox="0 0 820 360" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Multi-tower temporal alignment">
      <defs>
        <marker id="bta-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
          <path d="M0,0 L10,5 L0,10 z" fill="currentColor" />
        </marker>
      </defs>

      <text x="20" y="22" font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.55" letter-spacing="0.16em">CONTINUOUS-NATURALISTIC ALIGNMENT</text>

      <!-- Time axis -->
      <line x1="160" y1="320" x2="780" y2="320" stroke="currentColor" stroke-opacity="0.4" />
      <text x="160" y="340" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.55">0s</text>
      <text x="780" y="340" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.55" text-anchor="end">15s</text>
      <text x="470" y="340" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.5" text-anchor="middle">→ time</text>

      <!-- TR ticks every 1.5s (10 ticks across 15s) -->
      <g class="bta-tr-ticks"></g>
      <text x="160" y="58" font-family="var(--font-mono)" font-size="9" fill="var(--accent)" fill-opacity="0.85" letter-spacing="0.1em">BRAIN · TR = 1.5s</text>

      <!-- Three tower rows -->
      <!-- Vision tower row -->
      <g class="bta-row" data-row="vision">
        <g transform="translate(20 90)">
          <text font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.85" font-weight="600">VISION</text>
          <text y="14" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.55">tower</text>
          <text y="28" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.55">1 fps</text>
        </g>
        <line x1="160" y1="100" x2="780" y2="100" stroke="currentColor" stroke-opacity="0.15" />
        <g class="bta-vision-marks"></g>
      </g>

      <!-- Audio tower row -->
      <g class="bta-row" data-row="audio">
        <g transform="translate(20 150)">
          <text font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.85" font-weight="600">AUDIO</text>
          <text y="14" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.55">tower</text>
          <text y="28" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.55">50 Hz</text>
        </g>
        <line x1="160" y1="160" x2="780" y2="160" stroke="currentColor" stroke-opacity="0.15" />
        <g class="bta-audio-marks"></g>
      </g>

      <!-- Text tower row -->
      <g class="bta-row" data-row="text">
        <g transform="translate(20 210)">
          <text font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.85" font-weight="600">TEXT</text>
          <text y="14" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.55">tower</text>
          <text y="28" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.55">word-onset</text>
        </g>
        <line x1="160" y1="220" x2="780" y2="220" stroke="currentColor" stroke-opacity="0.15" />
        <g class="bta-text-marks"></g>
      </g>

      <!-- Predicted vs observed BOLD row -->
      <g>
        <g transform="translate(20 270)">
          <text font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.85" font-weight="600">BOLD</text>
          <text y="14" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.55">brain · TR</text>
        </g>
        <!-- Underlying neural event marker (anchor) -->
        <line class="bta-event" x1="0" y1="252" x2="0" y2="288" stroke="currentColor" stroke-opacity="0.6" stroke-dasharray="2 3" stroke-width="1.4" />
        <text class="bta-event-label" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.6" text-anchor="middle">event</text>
        <!-- Predicted BOLD curve, offset by the HRF slider -->
        <path class="bta-bold-curve" fill="none" stroke="var(--accent)" stroke-width="2" />
        <text class="bta-bold-label" font-family="var(--font-mono)" font-size="9" fill="var(--accent)" text-anchor="start">predicted BOLD</text>
      </g>
    </svg>

    <div class="bta-controls">
      <label>
        <span class="bta-ctrl-label">HRF delay <span class="bta-ctrl-val">5.0s</span></span>
        <input class="bta-hrf-input" type="range" min="0" max="10" step="0.1" value="5" />
      </label>
      <p class="bta-note">An event at <em>t</em> predicts BOLD at <em>t + delay</em>. Drag the slider to sweep the offset.</p>
    </div>
  </div>
  {caption && <figcaption class="bta-caption">{caption}</figcaption>}
</figure>

<script is:inline define:vars={{ uid }}>
  (function () {
    const NS = "http://www.w3.org/2000/svg";
    const X0 = 160;
    const X1 = 780;
    const T0 = 0;
    const T1 = 15;
    const TR = 1.5;
    const tToX = (t) => X0 + ((t - T0) / (T1 - T0)) * (X1 - X0);

    function makeMark(parent, x, y, w, h, opacity = 0.65) {
      const r = document.createElementNS(NS, "rect");
      r.setAttribute("x", x.toFixed(1));
      r.setAttribute("y", y.toFixed(1));
      r.setAttribute("width", w.toFixed(1));
      r.setAttribute("height", h.toFixed(1));
      r.setAttribute("rx", "1");
      r.setAttribute("fill", "var(--accent)");
      r.setAttribute("fill-opacity", opacity.toFixed(2));
      parent.appendChild(r);
    }

    function bind() {
      const root = document.querySelector(`[data-uid="${uid}"]`);
      if (!root || root.__bound) return;
      root.__bound = true;

      const trGroup = root.querySelector(".bta-tr-ticks");
      const visionMarks = root.querySelector(".bta-vision-marks");
      const audioMarks = root.querySelector(".bta-audio-marks");
      const textMarks = root.querySelector(".bta-text-marks");
      const eventLine = root.querySelector(".bta-event");
      const eventLabel = root.querySelector(".bta-event-label");
      const boldCurve = root.querySelector(".bta-bold-curve");
      const boldLabel = root.querySelector(".bta-bold-label");
      const hrfInput = root.querySelector(".bta-hrf-input");
      const hrfVal = root.querySelector(".bta-ctrl-val");

      // TR ticks
      for (let t = 0; t <= T1; t += TR) {
        const x = tToX(t);
        const tick = document.createElementNS(NS, "line");
        tick.setAttribute("x1", x.toFixed(1));
        tick.setAttribute("y1", "62");
        tick.setAttribute("x2", x.toFixed(1));
        tick.setAttribute("y2", "320");
        tick.setAttribute("stroke", "var(--accent)");
        tick.setAttribute("stroke-opacity", "0.18");
        tick.setAttribute("stroke-dasharray", "2 4");
        trGroup.appendChild(tick);
      }

      // Vision: 1 fps → 15 marks
      for (let t = 0.5; t < T1; t += 1) {
        const x = tToX(t);
        makeMark(visionMarks, x - 4, 92, 8, 16, 0.6);
      }
      // Audio: 50 Hz feels too dense; show every ~0.06s as fine slim marks
      for (let t = 0.04; t < T1; t += 0.08) {
        const x = tToX(t);
        makeMark(audioMarks, x, 152, 1.2, 16, 0.45);
      }
      // Text: word-onsets, irregular timing — just realistic fake stamps
      const wordOnsets = [0.3, 0.55, 0.85, 1.4, 2.1, 2.6, 3.5, 4.0, 4.4, 5.1, 5.9, 6.4, 7.0, 7.8, 8.6, 9.4, 10.0, 10.7, 11.3, 12.0, 12.7, 13.5, 14.2];
      for (const t of wordOnsets) {
        const x = tToX(t);
        makeMark(textMarks, x - 2, 212, 3, 16, 0.7);
      }

      // Anchor: an event at t=4s
      const eventT = 4;
      const eventX = tToX(eventT);
      eventLine.setAttribute("x1", eventX.toFixed(1));
      eventLine.setAttribute("x2", eventX.toFixed(1));
      eventLabel.setAttribute("x", eventX.toFixed(1));
      eventLabel.setAttribute("y", "248");

      function updateHRF() {
        const delay = parseFloat(hrfInput.value);
        hrfVal.textContent = delay.toFixed(1) + "s";

        // Canonical HRF (double-gamma simplified): peak at delay seconds
        // We'll draw a curve centered at eventT + delay
        const peakT = eventT + delay;
        const sigma = 1.6;
        const undershoot = 0.20;
        const points = [];
        for (let t = 0; t <= T1; t += 0.1) {
          // Positive lobe (gaussian-ish) + small undershoot
          const u = (t - peakT) / sigma;
          const pos = Math.exp(-u * u);
          const u2 = (t - peakT - 4) / 2.4;
          const neg = -undershoot * Math.exp(-u2 * u2);
          const y = pos + neg;
          // Map y∈[-0.2, 1] → svg-y in [288, 240]
          const yMin = -0.2;
          const yMax = 1;
          const svgY = 288 - ((y - yMin) / (yMax - yMin)) * 48;
          points.push(`${tToX(t).toFixed(1)},${svgY.toFixed(1)}`);
        }
        boldCurve.setAttribute("d", "M " + points.join(" L "));

        // Position the predicted-BOLD label near the curve's peak
        const peakX = tToX(Math.min(peakT, T1 - 0.5));
        boldLabel.setAttribute("x", (peakX + 6).toFixed(1));
        boldLabel.setAttribute("y", "236");
      }

      hrfInput.addEventListener("input", updateHRF);
      updateHRF();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bind);
    } else {
      bind();
    }
    document.addEventListener("astro:page-load", bind);
  })();
</script>

<style>
  .bta-figure { margin: 1.6em 0; }
  .bta-frame {
    background: var(--light-bg);
    border-radius: 10px;
    padding: clamp(16px, 2vw, 28px);
    color: var(--light-fg);
  }
  .bta-frame svg { width: 100%; height: auto; display: block; }
  .bta-controls {
    margin-top: 18px;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 16px;
    align-items: end;
  }
  @media (max-width: 720px) {
    .bta-controls { grid-template-columns: 1fr; }
  }
  .bta-controls label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--light-fg-muted);
  }
  .bta-ctrl-label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .bta-ctrl-val {
    color: var(--light-fg);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    letter-spacing: 0;
  }
  .bta-controls input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 4px;
    background: color-mix(in srgb, var(--accent) 25%, var(--light-bg-soft));
    border-radius: 2px;
    outline: none;
    cursor: pointer;
  }
  .bta-controls input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 14px; height: 14px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--light-bg);
  }
  .bta-controls input[type="range"]::-moz-range-thumb {
    width: 14px; height: 14px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--light-bg);
  }
  .bta-note {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--light-fg-muted);
    margin: 0;
    line-height: 1.5;
  }
  .bta-caption {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    color: var(--light-fg-muted);
    margin-top: 10px;
    text-align: center;
  }
</style>
