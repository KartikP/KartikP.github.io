---
// NetworkTopology — hand-drawn SVG diagram of the homelab network.
// Three layers stacked top-to-bottom:
//   1. External access surfaces (Cloudflare Tunnel, Tailscale, WireGuard VPN egress)
//   2. Core: Flint2 router (with router-level WireGuard + AdGuard)
//   3. Devices and storage attached to the LAN
//
// Uses currentColor for line/text so the diagram inherits the page accent
// (per case study) and the reading colour. Designed for a cream background
// (currently --light-bg).

interface Props {
  caption?: string;
}

const { caption } = Astro.props;
---

<figure class="topology-figure">
  <div class="topology-frame">
    <svg
      viewBox="0 0 920 540"
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label="Homelab network topology"
    >
      <defs>
        <marker id="topo-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
          <path d="M0,0 L10,5 L0,10 z" fill="currentColor" />
        </marker>
        <marker id="topo-arrow-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--accent)" />
        </marker>
      </defs>

      {/* ============ Layer 1 — External access (top) ============ */}
      <g class="topo-layer-label" transform="translate(20 24)">
        <text font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.5" letter-spacing="0.16em">EXTERNAL ACCESS</text>
      </g>

      {/* Cloudflare Tunnel */}
      <g transform="translate(60 50)">
        <rect width="200" height="56" rx="8" fill="none" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.4"/>
        <text x="14" y="22" font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.55" letter-spacing="0.12em">CLOUDFLARE TUNNEL</text>
        <text x="14" y="42" font-family="var(--font-sans)" font-size="13" fill="currentColor" fill-weight="500">4 services · Zero Trust</text>
      </g>

      {/* WireGuard VPN egress */}
      <g transform="translate(360 50)">
        <rect width="200" height="56" rx="8" fill="none" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.4"/>
        <text x="14" y="22" font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.55" letter-spacing="0.12em">WIREGUARD VPN</text>
        <text x="14" y="42" font-family="var(--font-sans)" font-size="13" fill="currentColor">Egress · kill switch</text>
      </g>

      {/* Tailscale */}
      <g transform="translate(660 50)">
        <rect width="200" height="56" rx="8" fill="none" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.4"/>
        <text x="14" y="22" font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.55" letter-spacing="0.12em">TAILSCALE</text>
        <text x="14" y="42" font-family="var(--font-sans)" font-size="13" fill="currentColor">SSH · admin</text>
      </g>

      {/* Connectors from external to router */}
      <path d="M 160 106 L 160 150 L 460 150 L 460 174" fill="none" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.4" stroke-dasharray="4 4"/>
      <path d="M 460 106 L 460 174" fill="none" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.4" stroke-dasharray="4 4"/>
      <path d="M 760 106 L 760 150 L 460 150" fill="none" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.4" stroke-dasharray="4 4"/>

      {/* ============ Layer 2 — Router (middle) ============ */}
      <g transform="translate(280 174)">
        <rect width="360" height="78" rx="10" fill="var(--accent)" fill-opacity="0.08" stroke="var(--accent)" stroke-width="1.6"/>
        <text x="20" y="24" font-family="var(--font-mono)" font-size="10" fill="var(--accent)" letter-spacing="0.16em">ROUTER · 192.168.8.1</text>
        <text x="20" y="46" font-family="var(--font-sans)" font-size="16" font-weight="600" fill="currentColor">GL.iNet Flint2</text>
        <text x="20" y="65" font-family="var(--font-mono)" font-size="11" fill="currentColor" fill-opacity="0.6">AdGuard · WireGuard · port-fwd</text>
      </g>

      {/* Router → server arrow */}
      <line x1="460" y1="252" x2="460" y2="296" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#topo-arrow-accent)"/>

      {/* ============ Layer 3 — Server + DAS + leaf devices ============ */}

      {/* Server box */}
      <g transform="translate(60 296)">
        <rect width="450" height="180" rx="10" fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.6"/>
        <text x="20" y="24" font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.55" letter-spacing="0.16em">SERVER · 192.168.8.223</text>
        <text x="20" y="46" font-family="var(--font-sans)" font-size="16" font-weight="600" fill="currentColor">HP EliteDesk 800 G6 Mini</text>
        <text x="20" y="65" font-family="var(--font-mono)" font-size="11" fill="currentColor" fill-opacity="0.6">Debian 13 · ~40 containers</text>

        {/* Container groups */}
        <g transform="translate(20 88)">
          <rect width="125" height="34" rx="4" fill="currentColor" fill-opacity="0.06"/>
          <text x="62.5" y="14" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.55" text-anchor="middle" letter-spacing="0.08em">MEDIA</text>
          <text x="62.5" y="27" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.8" text-anchor="middle">Plex · Kavita · tooling</text>
        </g>
        <g transform="translate(155 88)">
          <rect width="125" height="34" rx="4" fill="currentColor" fill-opacity="0.06"/>
          <text x="62.5" y="14" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.55" text-anchor="middle" letter-spacing="0.08em">PHOTOS</text>
          <text x="62.5" y="27" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.8" text-anchor="middle">Immich · ML · Postgres</text>
        </g>
        <g transform="translate(290 88)">
          <rect width="140" height="34" rx="4" fill="currentColor" fill-opacity="0.06"/>
          <text x="70" y="14" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.55" text-anchor="middle" letter-spacing="0.08em">HOME AUTOMATION</text>
          <text x="70" y="27" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.8" text-anchor="middle">HA · Matter · Hue</text>
        </g>
        <g transform="translate(20 130)">
          <rect width="125" height="34" rx="4" fill="currentColor" fill-opacity="0.06"/>
          <text x="62.5" y="14" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.55" text-anchor="middle" letter-spacing="0.08em">MONITORING</text>
          <text x="62.5" y="27" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.8" text-anchor="middle">Beszel · Scrutiny · ntopng</text>
        </g>
        <g transform="translate(155 130)">
          <rect width="125" height="34" rx="4" fill="currentColor" fill-opacity="0.06"/>
          <text x="62.5" y="14" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.55" text-anchor="middle" letter-spacing="0.08em">PROJECTS</text>
          <text x="62.5" y="27" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.8" text-anchor="middle">Health · Vivarium</text>
        </g>
        <g transform="translate(290 130)">
          <rect width="140" height="34" rx="4" fill="currentColor" fill-opacity="0.06"/>
          <text x="70" y="14" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.55" text-anchor="middle" letter-spacing="0.08em">DASHBOARD · MGMT</text>
          <text x="70" y="27" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.8" text-anchor="middle">Homepage · Portainer</text>
        </g>
      </g>

      {/* Server → DAS connector */}
      <path d="M 510 386 L 560 386" fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.4" marker-end="url(#topo-arrow)"/>
      <text x="535" y="378" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.5" text-anchor="middle" letter-spacing="0.08em">USB-C 10G</text>

      {/* DAS box */}
      <g transform="translate(560 296)">
        <rect width="300" height="180" rx="10" fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.6"/>
        <text x="20" y="24" font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.55" letter-spacing="0.16em">STORAGE · /MNT/STORAGE</text>
        <text x="20" y="46" font-family="var(--font-sans)" font-size="16" font-weight="600" fill="currentColor">TerraMaster D6-320</text>
        <text x="20" y="65" font-family="var(--font-mono)" font-size="11" fill="currentColor" fill-opacity="0.6">mergerfs · 55 TB · SnapRAID</text>

        {/* Drives — 5 data + 1 parity */}
        <g transform="translate(20 88)">
          {/* Protected drives */}
          <g>
            <rect x="0"   y="0" width="40" height="50" rx="4" fill="var(--accent)" fill-opacity="0.18" stroke="var(--accent)" stroke-width="1.2"/>
            <text x="20" y="20" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.7" text-anchor="middle">disk1</text>
            <text x="20" y="32" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.7" text-anchor="middle">13T</text>
            <text x="20" y="44" font-family="var(--font-mono)" font-size="8" fill="var(--accent)" text-anchor="middle">●</text>
          </g>
          <g transform="translate(46 0)">
            <rect x="0" y="0" width="40" height="50" rx="4" fill="var(--accent)" fill-opacity="0.18" stroke="var(--accent)" stroke-width="1.2"/>
            <text x="20" y="20" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.7" text-anchor="middle">disk2</text>
            <text x="20" y="32" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.7" text-anchor="middle">7.3T</text>
            <text x="20" y="44" font-family="var(--font-mono)" font-size="8" fill="var(--accent)" text-anchor="middle">●</text>
          </g>
          <g transform="translate(92 0)">
            <rect x="0" y="0" width="40" height="50" rx="4" fill="var(--accent)" fill-opacity="0.18" stroke="var(--accent)" stroke-width="1.2"/>
            <text x="20" y="20" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.7" text-anchor="middle">disk4</text>
            <text x="20" y="32" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.7" text-anchor="middle">7.3T</text>
            <text x="20" y="44" font-family="var(--font-mono)" font-size="8" fill="var(--accent)" text-anchor="middle">●</text>
          </g>
          <g transform="translate(138 0)">
            <rect x="0" y="0" width="40" height="50" rx="4" fill="var(--accent)" fill-opacity="0.18" stroke="var(--accent)" stroke-width="1.2"/>
            <text x="20" y="20" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.7" text-anchor="middle">disk5</text>
            <text x="20" y="32" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.7" text-anchor="middle">7.3T</text>
            <text x="20" y="44" font-family="var(--font-mono)" font-size="8" fill="var(--accent)" text-anchor="middle">●</text>
          </g>
          {/* Unprotected disk6 */}
          <g transform="translate(184 0)">
            <rect x="0" y="0" width="40" height="50" rx="4" fill="none" stroke="currentColor" stroke-opacity="0.55" stroke-width="1.2" stroke-dasharray="3 3"/>
            <text x="20" y="20" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.7" text-anchor="middle">disk6</text>
            <text x="20" y="32" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.7" text-anchor="middle">22T</text>
            <text x="20" y="44" font-family="var(--font-mono)" font-size="8" fill="currentColor" fill-opacity="0.5" text-anchor="middle">○</text>
          </g>
          {/* Parity */}
          <g transform="translate(238 0)">
            <rect x="0" y="0" width="40" height="50" rx="4" fill="currentColor" fill-opacity="0.04" stroke="currentColor" stroke-opacity="0.6" stroke-width="1.2"/>
            <text x="20" y="20" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.7" text-anchor="middle">parity</text>
            <text x="20" y="32" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.7" text-anchor="middle">13T</text>
            <text x="20" y="44" font-family="var(--font-mono)" font-size="8" fill="currentColor" fill-opacity="0.6" text-anchor="middle">★</text>
          </g>
        </g>

        {/* Drive legend */}
        <g transform="translate(20 152)">
          <text font-family="var(--font-mono)" font-size="9" fill="var(--accent)">●</text>
          <text x="12" y="0" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.6">protected</text>
          <text x="90" y="0" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.5">○ unprotected</text>
          <text x="200" y="0" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.6">★ parity</text>
        </g>
      </g>

      {/* Router → leaf devices arrow */}
      <line x1="280" y1="213" x2="100" y2="213" stroke="currentColor" stroke-opacity="0.4" stroke-width="1.4" marker-end="url(#topo-arrow)"/>
      <line x1="640" y1="213" x2="820" y2="213" stroke="currentColor" stroke-opacity="0.4" stroke-width="1.4" marker-end="url(#topo-arrow)"/>

      {/* Leaf devices — left side */}
      <g transform="translate(20 224)">
        <text font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.55" letter-spacing="0.12em">LEAF DEVICES</text>
        <text y="14" font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.7">2× Apple TV</text>
        <text y="28" font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.7">3× Laptops</text>
        <text y="42" font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.7">Mobile devices</text>
      </g>

      {/* Leaf devices — right side */}
      <g transform="translate(820 224)">
        <text font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.55" letter-spacing="0.12em">SMART HOME</text>
        <text y="14" font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.7">Hue Bridge</text>
        <text y="28" font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.7">2× outlets · 4× bulbs</text>
        <text y="42" font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.7">3× switches · plug-mon</text>
      </g>

      {/* Bottom subnet label */}
      <text x="460" y="510" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.5" text-anchor="middle" letter-spacing="0.16em">LAN · 192.168.8.0/24</text>
    </svg>
  </div>
  {caption && <figcaption class="topology-caption">{caption}</figcaption>}
</figure>

<style>
  .topology-figure { margin: 1.6em 0; }
  .topology-frame {
    background: var(--light-bg);
    border-radius: 10px;
    padding: clamp(16px, 2vw, 28px);
    color: var(--light-fg);
  }
  .topology-frame svg { width: 100%; height: auto; display: block; }
  .topology-caption {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    color: var(--light-fg-muted);
    margin-top: 10px;
    text-align: center;
  }
</style>
