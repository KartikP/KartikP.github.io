---
// BsInputEvents — interactive switcher for the three input event types
// that flow through `process()`. Click a tab to swap the diagram between
// StimulusSet, StateChange, and EnvironmentStep, showing the data the
// model receives, what it does, and what it returns for each shape.
//
// All content is rendered as native SVG <text>/<rect> elements (no
// foreignObject) so layout is deterministic across browsers.

interface Props {
  caption?: string;
}
const { caption } = Astro.props;
const uid = "bie-" + Math.random().toString(36).slice(2, 8);
---

<figure class="bie-figure" data-uid={uid}>
  <div class="bie-frame">
    <div class="bie-tabs" role="tablist">
      <button class="bie-tab is-active" data-event="stimulus" type="button" role="tab" aria-selected="true">StimulusSet</button>
      <button class="bie-tab" data-event="state" type="button" role="tab" aria-selected="false">StateChange</button>
      <button class="bie-tab" data-event="env" type="button" role="tab" aria-selected="false">EnvironmentStep</button>
    </div>

    <svg viewBox="0 0 820 320" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Input event dispatch">
      <defs>
        <marker id="bie-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--accent)" />
        </marker>
      </defs>

      <text x="410" y="22" class="bie-hint" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.5" letter-spacing="0.1em" text-anchor="middle">USED FOR PERCEPTUAL EVALUATION — IMAGES · TEXT · VIDEO · AUDIO</text>

      <!-- INPUT side -->
      <g transform="translate(40 50)">
        <rect width="240" height="240" rx="10" fill="none" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.4" stroke-dasharray="3 3" />
        <text x="120" y="22" font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.55" letter-spacing="0.16em" text-anchor="middle">INPUT EVENT</text>
        <text x="120" y="44" class="bie-input-title" font-family="var(--font-sans)" font-size="15" font-weight="600" fill="currentColor" text-anchor="middle">StimulusSet</text>
        <g class="bie-input-rows" transform="translate(0 60)"></g>
      </g>

      <!-- ARROW into model -->
      <line x1="280" y1="170" x2="320" y2="170" stroke="var(--accent)" stroke-width="2" marker-end="url(#bie-arrow)" />
      <text x="300" y="160" font-family="var(--font-mono)" font-size="9" fill="var(--accent)" text-anchor="middle">process()</text>

      <!-- MODEL center -->
      <g transform="translate(320 50)">
        <rect width="180" height="240" rx="10" fill="var(--accent)" fill-opacity="0.08" stroke="var(--accent)" stroke-width="1.6" />
        <text x="90" y="22" font-family="var(--font-mono)" font-size="10" fill="var(--accent)" letter-spacing="0.16em" text-anchor="middle">MODEL</text>
        <text x="90" y="44" font-family="var(--font-sans)" font-size="14" font-weight="600" fill="currentColor" text-anchor="middle">UnifiedModel</text>
        <text x="90" y="62" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.7" text-anchor="middle">dispatches on type</text>
        <g class="bie-model-rows" transform="translate(0 80)"></g>
      </g>

      <!-- ARROW out -->
      <line x1="500" y1="170" x2="540" y2="170" stroke="var(--accent)" stroke-width="2" marker-end="url(#bie-arrow)" />
      <text x="520" y="160" font-family="var(--font-mono)" font-size="9" fill="var(--accent)" text-anchor="middle">return</text>

      <!-- OUTPUT side -->
      <g transform="translate(540 50)">
        <rect width="240" height="240" rx="10" fill="none" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.4" />
        <text x="120" y="22" font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.55" letter-spacing="0.16em" text-anchor="middle">RESPONSE</text>
        <text x="120" y="44" class="bie-output-title" font-family="var(--font-sans)" font-size="15" font-weight="600" fill="currentColor" text-anchor="middle">DataAssembly</text>
        <g class="bie-output-rows" transform="translate(0 60)"></g>
      </g>
    </svg>
  </div>
  {caption && <figcaption class="bie-caption">{caption}</figcaption>}
</figure>

<script is:inline define:vars={{ uid }}>
  (function () {
    const NS = "http://www.w3.org/2000/svg";

    const PAYLOADS = {
      stimulus: {
        inputTitle: "StimulusSet",
        outputTitle: "DataAssembly",
        hint: "USED FOR PERCEPTUAL EVALUATION — IMAGES · TEXT · VIDEO · AUDIO",
        input: [
          { tag: "image", text: "movie_frame_001.jpg" },
          { tag: "audio", text: "audio_clip_001.wav" },
          { tag: "text",  text: '"…and then the door opened."' },
        ],
        model: [
          { tag: "match", text: "input ⊆ available" },
          { tag: "fwd",   text: "preprocess → wrappers" },
        ],
        output: [
          { tag: "neural", text: "[layer, time, unit]" },
          { tag: "behave", text: "[trial, label]" },
        ],
      },
      state: {
        inputTitle: "StateChange",
        outputTitle: "PerturbationHandle",
        hint: "USED FOR PERTURBATION EXPERIMENTS — APPLY · MEASURE · RESET",
        input: [
          { tag: "kind", text: "apply" },
          { tag: "target", text: "lm.layers.20.mlp" },
          { tag: "perturb", text: "zero · face_units" },
        ],
        model: [
          { tag: "hook", text: "register fwd hook" },
          { tag: "store", text: "save baseline" },
        ],
        output: [
          { tag: "handle", text: "id = 'h-7f2a'" },
          { tag: "reset",  text: "reset(id) → restored" },
        ],
      },
      env: {
        inputTitle: "EnvironmentStep",
        outputTitle: "EnvironmentResponse",
        hint: "USED FOR EMBODIED AGENTS — OBSERVATION → 7-DOF ACTION",
        input: [
          { tag: "camera", text: "primary, wrist (RGB)" },
          { tag: "proprio", text: "joints[7], gripper" },
          { tag: "instr", text: '"pick up red block"' },
        ],
        model: [
          { tag: "encode", text: "vision · text · proprio" },
          { tag: "step", text: "policy(obs) → action" },
        ],
        output: [
          { tag: "action", text: "[Δx Δy Δz Δr...· grip]" },
          { tag: "logp",   text: "log-prob per dim" },
        ],
      },
    };

    function bind() {
      const root = document.querySelector(`[data-uid="${uid}"]`);
      if (!root || root.__bound) return;
      root.__bound = true;

      const tabs = root.querySelectorAll(".bie-tab");
      const inputTitle = root.querySelector(".bie-input-title");
      const outputTitle = root.querySelector(".bie-output-title");
      const hint = root.querySelector(".bie-hint");
      const inputRows = root.querySelector(".bie-input-rows");
      const modelRows = root.querySelector(".bie-model-rows");
      const outputRows = root.querySelector(".bie-output-rows");

      function clear(g) {
        while (g.firstChild) g.removeChild(g.firstChild);
      }

      function renderRows(host, rows, opts) {
        clear(host);
        const padX = opts.padX ?? 16;
        const rowGap = 22;
        const tagH = 14;
        const tagPad = 6;
        const tagFont = 8;
        const charPx = 4.6; // approximate width per char at font-size 8 mono
        const bodyFont = 9;

        for (let i = 0; i < rows.length; i++) {
          const r = rows[i];
          const y = i * rowGap;
          const tagW = Math.max(28, r.tag.length * charPx + tagPad * 2);

          const rect = document.createElementNS(NS, "rect");
          rect.setAttribute("x", padX);
          rect.setAttribute("y", y);
          rect.setAttribute("width", tagW.toFixed(1));
          rect.setAttribute("height", tagH);
          rect.setAttribute("rx", 2);
          rect.setAttribute("fill", "var(--accent)");
          rect.setAttribute("fill-opacity", "0.18");
          host.appendChild(rect);

          const tagText = document.createElementNS(NS, "text");
          tagText.setAttribute("x", (padX + tagW / 2).toFixed(1));
          tagText.setAttribute("y", y + 10);
          tagText.setAttribute("font-family", "var(--font-mono)");
          tagText.setAttribute("font-size", tagFont);
          tagText.setAttribute("fill", "var(--accent)");
          tagText.setAttribute("text-anchor", "middle");
          tagText.setAttribute("letter-spacing", "0.06em");
          tagText.textContent = r.tag.toUpperCase();
          host.appendChild(tagText);

          const body = document.createElementNS(NS, "text");
          body.setAttribute("x", (padX + tagW + 8).toFixed(1));
          body.setAttribute("y", y + 10);
          body.setAttribute("font-family", "var(--font-mono)");
          body.setAttribute("font-size", bodyFont);
          body.setAttribute("fill", "currentColor");
          body.setAttribute("fill-opacity", "0.78");
          body.textContent = r.text;
          host.appendChild(body);
        }
      }

      function setEvent(key) {
        const data = PAYLOADS[key];
        if (!data) return;
        inputTitle.textContent = data.inputTitle;
        outputTitle.textContent = data.outputTitle;
        hint.textContent = data.hint;
        renderRows(inputRows, data.input, { padX: 16 });
        renderRows(modelRows, data.model, { padX: 14 });
        renderRows(outputRows, data.output, { padX: 16 });
        tabs.forEach((t) => {
          const active = t.getAttribute("data-event") === key;
          t.classList.toggle("is-active", active);
          t.setAttribute("aria-selected", active ? "true" : "false");
        });
      }

      tabs.forEach((t) => t.addEventListener("click", () => setEvent(t.getAttribute("data-event"))));
      setEvent("stimulus");
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bind);
    } else {
      bind();
    }
    document.addEventListener("astro:page-load", bind);
  })();
</script>

<style>
  .bie-figure { margin: 1.6em 0; }
  .bie-frame {
    background: var(--light-bg);
    border-radius: 10px;
    padding: clamp(16px, 2vw, 28px);
    color: var(--light-fg);
  }
  .bie-frame svg { width: 100%; height: auto; display: block; }
  .bie-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .bie-tab {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    color: var(--light-fg-muted);
    padding: 6px 12px;
    border-radius: 4px;
    cursor: pointer;
    transition: background 150ms ease, color 150ms ease;
  }
  .bie-tab:hover { color: var(--light-fg); }
  .bie-tab.is-active {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
  }
  .bie-caption {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    color: var(--light-fg-muted);
    margin-top: 10px;
    text-align: center;
  }
</style>
