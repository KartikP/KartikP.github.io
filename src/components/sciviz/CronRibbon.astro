---
// CronRibbon — 24-hour timeline of scheduled jobs running on the
// homelab. Each row is one job; markers indicate when it fires. The
// ribbon makes the daily rhythm visible at a glance instead of as a
// flat bullet list.
//
// Static SVG. currentColor + var(--accent) for theming.

interface Props {
  caption?: string;
}

const { caption } = Astro.props;

const VB_W = 800;
const VB_H = 220;
const PAD_L = 170;
const PAD_R = 30;
const TIMELINE_W = VB_W - PAD_L - PAD_R;
const PAD_T = 56;
const ROW_H = 30;
const ROW_GAP = 6;

const hourTicks = [0, 4, 8, 12, 16, 20, 24];
const hourToX = (h: number) => PAD_L + (h / 24) * TIMELINE_W;

interface Job {
  label: string;
  desc: string;
  hour: number;
  minute: number;
  cadence: "daily" | "hourly" | "weekly";
  weeklyOn?: string; // e.g. "Sun" — only used when cadence === "weekly"
}

const jobs: Job[] = [
  { label: "cron-sync.sh",   desc: "Oura · Strava sync (hourly)", hour: 0, minute: 0,  cadence: "hourly" },
  { label: "backup.sh",      desc: "appdata + Immich DB + .env",  hour: 3, minute: 0,  cadence: "daily"  },
  { label: "backup-health-db.sh", desc: "Health-DB dump (Sundays)",  hour: 3, minute: 30, cadence: "weekly", weeklyOn: "Sun" },
  { label: "snapraid-sync.sh", desc: "SnapRAID sync + 5% scrub",  hour: 4, minute: 0,  cadence: "daily"  },
];
---

<figure class="cron-figure">
  <div class="cron-frame">
    <svg viewBox={`0 0 ${VB_W} ${VB_H}`} preserveAspectRatio="xMidYMid meet" role="img" aria-label="Cron schedule">
      {/* Heading */}
      <text x="20" y="22" font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.55" letter-spacing="0.16em">CRON SCHEDULE · 24h</text>

      {/* Hour-tick axis */}
      <line x1={PAD_L} y1={PAD_T - 16} x2={PAD_L + TIMELINE_W} y2={PAD_T - 16} stroke="currentColor" stroke-opacity="0.3" />
      {hourTicks.map((h) => {
        const x = hourToX(h);
        return (
          <g>
            <line x1={x} y1={PAD_T - 20} x2={x} y2={PAD_T - 12} stroke="currentColor" stroke-opacity="0.45" />
            <text x={x} y={PAD_T - 24} font-family="var(--font-mono)" font-size="9" text-anchor="middle" fill="currentColor" fill-opacity="0.55">{String(h).padStart(2, "0")}:00</text>
          </g>
        );
      })}

      {/* Quiet shading: 0–6 (overnight maintenance window) */}
      <rect x={PAD_L} y={PAD_T - 12} width={hourToX(6) - PAD_L} height={ROW_H * jobs.length + ROW_GAP * (jobs.length - 1) + 16}
            fill="var(--accent)" fill-opacity="0.04" />

      {/* Job rows */}
      {jobs.map((job, i) => {
        const y = PAD_T + i * (ROW_H + ROW_GAP);
        return (
          <g>
            {/* Row label */}
            <text x={PAD_L - 12} y={y + 12} font-family="var(--font-mono)" font-size="11" font-weight="600" text-anchor="end" fill="currentColor" fill-opacity="0.85">{job.label}</text>
            <text x={PAD_L - 12} y={y + 25} font-family="var(--font-mono)" font-size="9" text-anchor="end" fill="currentColor" fill-opacity="0.55">{job.desc}</text>

            {/* Row baseline */}
            <line x1={PAD_L} y1={y + ROW_H / 2} x2={PAD_L + TIMELINE_W} y2={y + ROW_H / 2}
                  stroke="currentColor" stroke-opacity="0.1" />

            {/* Markers */}
            {job.cadence === "hourly" && Array.from({ length: 24 }, (_, h) => (
              <circle cx={hourToX(h)} cy={y + ROW_H / 2} r="2.5"
                      fill="var(--accent)" fill-opacity="0.55" />
            ))}
            {job.cadence === "daily" && (
              <g>
                <circle cx={hourToX(job.hour + job.minute / 60)} cy={y + ROW_H / 2} r="6"
                        fill="var(--accent)" />
                <line x1={hourToX(job.hour + job.minute / 60)} y1={y + 4} x2={hourToX(job.hour + job.minute / 60)} y2={y + ROW_H - 4}
                      stroke="var(--accent)" stroke-width="2" />
                <text x={hourToX(job.hour + job.minute / 60)} y={y - 4} font-family="var(--font-mono)" font-size="9" text-anchor="middle" fill="var(--accent)">{`${String(job.hour).padStart(2, "0")}:${String(job.minute).padStart(2, "0")}`}</text>
              </g>
            )}
            {job.cadence === "weekly" && (
              <g>
                <circle cx={hourToX(job.hour + job.minute / 60)} cy={y + ROW_H / 2} r="6"
                        fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-dasharray="2 2" />
                <line x1={hourToX(job.hour + job.minute / 60)} y1={y + 4} x2={hourToX(job.hour + job.minute / 60)} y2={y + ROW_H - 4}
                      stroke="var(--accent)" stroke-width="1.6" stroke-dasharray="2 2" />
                <text x={hourToX(job.hour + job.minute / 60)} y={y - 4} font-family="var(--font-mono)" font-size="9" text-anchor="middle" fill="var(--accent)" fill-opacity="0.7">{`${String(job.hour).padStart(2, "0")}:${String(job.minute).padStart(2, "0")} ${job.weeklyOn}`}</text>
              </g>
            )}
          </g>
        );
      })}

      {/* Legend */}
      <g transform={`translate(${PAD_L} ${VB_H - 14})`}>
        <circle cx="6" cy="-3" r="2.5" fill="var(--accent)" fill-opacity="0.55" />
        <text x="16" y="0" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.6">hourly</text>
        <circle cx="92" cy="-3" r="5" fill="var(--accent)" />
        <text x="104" y="0" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.6">daily</text>
        <circle cx="166" cy="-3" r="5" fill="none" stroke="var(--accent)" stroke-width="1.4" stroke-dasharray="2 2" />
        <text x="180" y="0" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.6">weekly</text>
        <text x={PAD_L + TIMELINE_W - PAD_L - 30} y="0" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.45" text-anchor="end">tinted band = overnight maintenance window</text>
      </g>
    </svg>
  </div>
  {caption && <figcaption class="cron-caption">{caption}</figcaption>}
</figure>

<style>
  .cron-figure { margin: 1.6em 0; }
  .cron-frame {
    background: var(--light-bg);
    border-radius: 10px;
    padding: clamp(16px, 2vw, 28px);
    color: var(--light-fg);
  }
  .cron-frame svg { width: 100%; height: auto; display: block; }
  .cron-caption {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    color: var(--light-fg-muted);
    margin-top: 10px;
    text-align: center;
  }
</style>
