---
// BsArchitecture — static SVG of the four-repository structure for the
// unified Brain-Score model interface.
//   - `core` at top defines the UnifiedModel ABC and shared utilities.
//   - `vision` and `language` keep their legacy interfaces; an adapter
//     in each makes the legacy model look like a UnifiedModel.
//   - `unified` is a new repo for native UnifiedModel implementations
//     and the multimodal/perturbation/embodied infrastructure.
//   - Benchmarks always interact with a UnifiedModel — they never know
//     whether the underlying model is native or adapted.

interface Props {
  caption?: string;
}
const { caption } = Astro.props;
---

<figure class="bsa-figure">
  <div class="bsa-frame">
    <svg viewBox="0 0 820 460" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Repository architecture">
      <defs>
        <marker id="bsa-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
          <path d="M0,0 L10,5 L0,10 z" fill="currentColor" />
        </marker>
        <marker id="bsa-arrow-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--accent)" />
        </marker>
      </defs>

      <text x="20" y="22" font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.55" letter-spacing="0.16em">REPOSITORY ARCHITECTURE</text>

      <!-- core -->
      <g transform="translate(260 50)">
        <rect width="300" height="80" rx="10" fill="var(--accent)" fill-opacity="0.08" stroke="var(--accent)" stroke-width="1.6" />
        <text x="150" y="22" font-family="var(--font-mono)" font-size="10" fill="var(--accent)" letter-spacing="0.16em" text-anchor="middle">CORE · SHARED CONTRACTS</text>
        <text x="150" y="44" font-family="var(--font-sans)" font-size="15" font-weight="600" fill="currentColor" text-anchor="middle">UnifiedModel ABC</text>
        <text x="150" y="62" font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.65" text-anchor="middle">TaskContext · pre-flight check · temporal kit</text>
      </g>

      <!-- Three repos beneath core -->
      <!-- vision -->
      <g transform="translate(40 180)">
        <rect width="220" height="120" rx="10" fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.6" stroke-dasharray="3 3" />
        <text x="110" y="22" font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.6" letter-spacing="0.14em" text-anchor="middle">VISION (LEGACY)</text>
        <g transform="translate(20 36)">
          <rect width="180" height="32" rx="5" fill="currentColor" fill-opacity="0.05" />
          <text x="90" y="14" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.55" text-anchor="middle">BrainModel</text>
          <text x="90" y="26" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.85" text-anchor="middle">look_at()</text>
        </g>
        <g transform="translate(20 76)">
          <rect width="180" height="32" rx="5" fill="var(--accent)" fill-opacity="0.12" stroke="var(--accent)" stroke-opacity="0.6" stroke-width="1" />
          <text x="90" y="14" font-family="var(--font-mono)" font-size="9" fill="var(--accent)" text-anchor="middle">VISION ADAPTER</text>
          <text x="90" y="26" font-family="var(--font-mono)" font-size="9" fill="var(--accent)" text-anchor="middle">→ UnifiedModel</text>
        </g>
      </g>

      <!-- language -->
      <g transform="translate(300 180)">
        <rect width="220" height="120" rx="10" fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.6" stroke-dasharray="3 3" />
        <text x="110" y="22" font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.6" letter-spacing="0.14em" text-anchor="middle">LANGUAGE (LEGACY)</text>
        <g transform="translate(20 36)">
          <rect width="180" height="32" rx="5" fill="currentColor" fill-opacity="0.05" />
          <text x="90" y="14" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.55" text-anchor="middle">ArtificialSubject</text>
          <text x="90" y="26" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.85" text-anchor="middle">digest_text()</text>
        </g>
        <g transform="translate(20 76)">
          <rect width="180" height="32" rx="5" fill="var(--accent)" fill-opacity="0.12" stroke="var(--accent)" stroke-opacity="0.6" stroke-width="1" />
          <text x="90" y="14" font-family="var(--font-mono)" font-size="9" fill="var(--accent)" text-anchor="middle">LANGUAGE ADAPTER</text>
          <text x="90" y="26" font-family="var(--font-mono)" font-size="9" fill="var(--accent)" text-anchor="middle">→ UnifiedModel</text>
        </g>
      </g>

      <!-- unified -->
      <g transform="translate(560 180)">
        <rect width="220" height="120" rx="10" fill="var(--accent)" fill-opacity="0.05" stroke="var(--accent)" stroke-opacity="0.6" stroke-width="1.6" />
        <text x="110" y="22" font-family="var(--font-mono)" font-size="10" fill="var(--accent)" letter-spacing="0.14em" text-anchor="middle">UNIFIED (NEW)</text>
        <g transform="translate(20 36)">
          <rect width="180" height="32" rx="5" fill="var(--accent)" fill-opacity="0.18" />
          <text x="90" y="14" font-family="var(--font-mono)" font-size="9" fill="var(--accent)" text-anchor="middle">BrainScoreModel</text>
          <text x="90" y="26" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.7" text-anchor="middle">native UnifiedModel</text>
        </g>
        <g transform="translate(20 76)">
          <rect width="180" height="32" rx="5" fill="currentColor" fill-opacity="0.05" />
          <text x="90" y="14" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.55" text-anchor="middle">Wrappers · benchmarks</text>
          <text x="90" y="26" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.85" text-anchor="middle">multimodal · perturb · embod.</text>
        </g>
      </g>

      <!-- Connectors: core → each repo -->
      <line x1="320" y1="130" x2="160" y2="178" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.4" stroke-dasharray="3 3" />
      <line x1="410" y1="130" x2="410" y2="178" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.4" stroke-dasharray="3 3" />
      <line x1="500" y1="130" x2="660" y2="178" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.4" stroke-dasharray="3 3" />

      <!-- Aggregation arrow into the benchmark layer -->
      <path d="M 150 304 L 150 350 L 410 350" fill="none" stroke="var(--accent)" stroke-opacity="0.7" stroke-width="1.6" marker-end="url(#bsa-arrow-accent)" />
      <path d="M 410 304 L 410 350" fill="none" stroke="var(--accent)" stroke-opacity="0.7" stroke-width="1.6" marker-end="url(#bsa-arrow-accent)" />
      <path d="M 670 304 L 670 350 L 410 350" fill="none" stroke="var(--accent)" stroke-opacity="0.7" stroke-width="1.6" marker-end="url(#bsa-arrow-accent)" />

      <!-- Benchmark layer -->
      <g transform="translate(220 360)">
        <rect width="380" height="64" rx="10" fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.6" />
        <text x="190" y="22" font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.6" letter-spacing="0.14em" text-anchor="middle">BENCHMARK LAYER</text>
        <text x="190" y="44" font-family="var(--font-sans)" font-size="13" fill="currentColor" text-anchor="middle">always interacts with a UnifiedModel</text>
      </g>

      <!-- Caption-line at bottom -->
      <text x="410" y="446" font-family="var(--font-mono)" font-size="9" fill="currentColor" fill-opacity="0.5" letter-spacing="0.08em" text-anchor="middle">native or adapted — the benchmark cannot tell the difference</text>
    </svg>
  </div>
  {caption && <figcaption class="bsa-caption">{caption}</figcaption>}
</figure>

<style>
  .bsa-figure { margin: 1.6em 0; }
  .bsa-frame {
    background: var(--light-bg);
    border-radius: 10px;
    padding: clamp(16px, 2vw, 28px);
    color: var(--light-fg);
  }
  .bsa-frame svg { width: 100%; height: auto; display: block; }
  .bsa-caption {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    color: var(--light-fg-muted);
    margin-top: 10px;
    text-align: center;
  }
</style>
