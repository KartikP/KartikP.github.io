---
// PopulationDecode — a population-vector estimate of stimulus angle.
// N neurons live around the unit circle at their preferred angles. Each
// fires at a rate determined by Gaussian tuning to the (rotating) stimulus.
// We compute the population vector (Σ r_i · (cos φ_i, sin φ_i)) and draw
// it as the "estimate" arrow alongside the true stimulus arrow.
//
// As N grows, the estimate converges on truth. The slider lets the
// reader scrub through low-N noisy regimes up to high-N tight regimes.

interface Props {
  countDefault?: number;
  sigma?: number;
  speed?: number;
  caption?: string;
}

const { countDefault = 12, sigma = 0.5, speed = 0.4, caption } = Astro.props;
const uid = "pd-" + Math.random().toString(36).slice(2, 8);
---

<figure class="sciviz-figure" data-uid={uid}>
  <div class="sciviz-frame">
    <svg viewBox="0 0 600 320" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Population vector decoding">
      <g transform="translate(300 160)">
        <!-- Reference circle -->
        <circle r="120" fill="none" stroke="currentColor" stroke-opacity="0.12" />
        <circle r="2" fill="currentColor" fill-opacity="0.5" />
        <!-- Neurons -->
        <g class="neurons"></g>
        <!-- True stimulus arrow (subtle) -->
        <g class="true-arrow">
          <line class="true-line" x1="0" y1="0" x2="0" y2="0" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.6" stroke-dasharray="4 3" />
          <text class="true-label" font-family="var(--font-mono)" font-size="10" fill="currentColor" fill-opacity="0.6" letter-spacing="0.08em">TRUE</text>
        </g>
        <!-- Estimated arrow (bold) -->
        <g class="est-arrow">
          <line class="est-line" x1="0" y1="0" x2="0" y2="0" stroke="var(--accent)" stroke-width="2.5" />
          <polygon class="est-head" points="0,0" fill="var(--accent)" />
          <text class="est-label" font-family="var(--font-mono)" font-size="11" fill="var(--accent)" font-weight="600" letter-spacing="0.08em">ESTIMATE</text>
        </g>
      </g>
      <!-- Bottom: error readout -->
      <g transform="translate(20 296)">
        <text font-family="var(--font-mono)" font-size="11" fill="currentColor" fill-opacity="0.7" letter-spacing="0.08em">
          ERROR: <tspan class="err-val" font-weight="600" fill="var(--light-fg)">0°</tspan>
          <tspan dx="24" fill="currentColor" fill-opacity="0.7">N: <tspan class="n-val" font-weight="600" fill="var(--light-fg)">12</tspan></tspan>
        </text>
      </g>
    </svg>

    <div class="sciviz-controls">
      <label>
        <span class="ctrl-label">N <span class="ctrl-val n-display">12</span></span>
        <input class="n-input" type="range" min="2" max="100" step="1" value={countDefault} />
      </label>
      <label>
        <span class="ctrl-label">σ <span class="ctrl-val sigma-val">0.50</span></span>
        <input class="sigma-input" type="range" min="0.15" max="1.4" step="0.01" value={sigma} />
      </label>
      <button class="play-btn" type="button" aria-pressed="true">PAUSE</button>
    </div>
  </div>
  {caption && <figcaption class="sciviz-caption">{caption}</figcaption>}
</figure>

<script is:inline define:vars={{ uid, countDefault, sigma, speed }}>
  (function () {
    function bind() {
      const root = document.querySelector(`[data-uid="${uid}"]`);
      if (!root || root.__bound) return;
      root.__bound = true;

      const neuronsG = root.querySelector(".neurons");
      const trueLine = root.querySelector(".true-line");
      const trueLabel = root.querySelector(".true-label");
      const estLine = root.querySelector(".est-line");
      const estHead = root.querySelector(".est-head");
      const estLabel = root.querySelector(".est-label");
      const errVal = root.querySelector(".err-val");
      const nVal = root.querySelector(".n-val");
      const nDisplay = root.querySelector(".n-display");
      const nInput = root.querySelector(".n-input");
      const sigmaInput = root.querySelector(".sigma-input");
      const sigmaVal = root.querySelector(".sigma-val");
      const playBtn = root.querySelector(".play-btn");

      const RADIUS = 120;
      const NS = "http://www.w3.org/2000/svg";
      const MAX_N = 100;

      // Pre-create a max-N pool of neuron dots; we'll show/hide based on N
      const allPhis = [];
      for (let i = 0; i < MAX_N; i++) allPhis.push(Math.random() * Math.PI * 2);
      // Sort so increasing N adds neurons gradually around the circle
      const order = [];
      for (let i = 0; i < MAX_N; i++) order.push(i);
      // Permute so adding neurons spreads them around the circle
      order.sort(() => Math.random() - 0.5);
      const dots = allPhis.map(() => {
        const c = document.createElementNS(NS, "circle");
        c.setAttribute("r", "3");
        c.setAttribute("fill", "var(--accent)");
        neuronsG.appendChild(c);
        return c;
      });

      let theta = 0;
      let lastTime = performance.now();
      let running = true;
      let raf = null;

      function tick(now) {
        const dt = Math.min(0.05, (now - lastTime) / 1000);
        lastTime = now;
        if (running) {
          theta += speed * dt;
          if (theta > Math.PI * 2) theta -= Math.PI * 2;
        }

        const N = parseInt(nInput.value, 10);
        const sigmaCurrent = parseFloat(sigmaInput.value);

        // Population vector accumulator
        let sumX = 0, sumY = 0, sumR = 0;

        // Hide dots > N first
        for (let i = 0; i < MAX_N; i++) {
          dots[i].setAttribute("display", "none");
        }

        for (let i = 0; i < N; i++) {
          const idx = order[i];
          const phi = allPhis[idx];
          let dist = Math.abs(theta - phi);
          if (dist > Math.PI) dist = 2 * Math.PI - dist;
          // Add small Poisson-ish noise so estimate jitters at low N
          const ideal = Math.exp(-(dist * dist) / (2 * sigmaCurrent * sigmaCurrent));
          const noisy = Math.max(0, ideal + (Math.random() - 0.5) * 0.25);
          const r = 6 + ideal * (RADIUS - 6);
          const x = Math.cos(phi) * r;
          const y = -Math.sin(phi) * r;
          dots[idx].setAttribute("cx", x.toFixed(1));
          dots[idx].setAttribute("cy", y.toFixed(1));
          dots[idx].setAttribute("display", "");
          dots[idx].setAttribute("fill-opacity", (0.35 + ideal * 0.5).toFixed(2));

          sumX += noisy * Math.cos(phi);
          sumY += noisy * Math.sin(phi);
          sumR += noisy;
        }

        // Estimated angle
        let estAngle = 0;
        if (sumR > 1e-6) {
          estAngle = Math.atan2(sumY, sumX);
        }

        // True arrow
        const tx = Math.cos(theta) * RADIUS;
        const ty = -Math.sin(theta) * RADIUS;
        trueLine.setAttribute("x2", tx.toFixed(1));
        trueLine.setAttribute("y2", ty.toFixed(1));
        // True label slightly outside the line tip
        trueLabel.setAttribute("x", (tx * 1.12).toFixed(1));
        trueLabel.setAttribute("y", (ty * 1.12 + 4).toFixed(1));
        trueLabel.setAttribute("text-anchor", tx >= 0 ? "start" : "end");

        // Estimated arrow (length scales with confidence ∝ |sum| / N)
        const confidence = Math.min(1, sumR / Math.max(1, N * 0.4));
        const estLen = (0.4 + 0.6 * confidence) * RADIUS;
        const ex = Math.cos(estAngle) * estLen;
        const ey = -Math.sin(estAngle) * estLen;
        estLine.setAttribute("x2", ex.toFixed(1));
        estLine.setAttribute("y2", ey.toFixed(1));
        const headLen = 11;
        const ax = Math.cos(estAngle), ay = -Math.sin(estAngle);
        const bx = -ay, by = ax;
        const baseX = ex - ax * headLen, baseY = ey - ay * headLen;
        estHead.setAttribute("points",
          `${ex.toFixed(1)},${ey.toFixed(1)} ${(baseX + bx*5).toFixed(1)},${(baseY + by*5).toFixed(1)} ${(baseX - bx*5).toFixed(1)},${(baseY - by*5).toFixed(1)}`);
        estLabel.setAttribute("x", (ex * 1.12).toFixed(1));
        estLabel.setAttribute("y", (ey * 1.12 - 4).toFixed(1));
        estLabel.setAttribute("text-anchor", ex >= 0 ? "start" : "end");

        // Error
        let err = Math.abs(estAngle - theta);
        if (err > Math.PI) err = 2 * Math.PI - err;
        const errDeg = (err * 180 / Math.PI).toFixed(1);
        errVal.textContent = errDeg + "°";
        nVal.textContent = N;
        nDisplay.textContent = N;
        sigmaVal.textContent = sigmaCurrent.toFixed(2);

        raf = requestAnimationFrame(tick);
      }

      playBtn.addEventListener("click", () => {
        running = !running;
        playBtn.textContent = running ? "PAUSE" : "PLAY";
        playBtn.setAttribute("aria-pressed", String(running));
      });

      raf = requestAnimationFrame(tick);
      root.__cleanup = () => raf && cancelAnimationFrame(raf);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bind);
    } else {
      bind();
    }
    document.addEventListener("astro:page-load", bind);
  })();
</script>

<style>
  .sciviz-figure { margin: 1.2em 0 1.6em; }
  .sciviz-frame {
    background: var(--light-bg-soft); border-radius: 10px;
    padding: clamp(20px, 2.5vw, 32px); color: var(--light-fg);
  }
  .sciviz-frame svg { width: 100%; height: auto; display: block; }
  .sciviz-controls {
    margin-top: 16px; display: grid;
    grid-template-columns: 1fr 1fr auto; gap: 16px 24px; align-items: end;
  }
  .sciviz-controls label {
    display: flex; flex-direction: column; gap: 6px;
    font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--light-fg-muted);
  }
  .ctrl-label { display: flex; justify-content: space-between; align-items: baseline; }
  .ctrl-val { color: var(--light-fg); font-variant-numeric: tabular-nums; font-weight: 600; letter-spacing: 0; }
  .sciviz-controls input[type="range"] {
    -webkit-appearance: none; appearance: none; width: 100%;
    height: 4px; background: color-mix(in srgb, var(--accent) 25%, var(--light-bg-soft));
    border-radius: 2px; outline: none; cursor: pointer;
  }
  .sciviz-controls input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none;
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--accent); border: 2px solid var(--light-bg);
  }
  .sciviz-controls input[type="range"]::-moz-range-thumb {
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--accent); border: 2px solid var(--light-bg);
  }
  .play-btn {
    font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.12em; text-transform: uppercase;
    background: var(--accent); color: white;
    border: none; padding: 9px 14px; border-radius: 4px;
    cursor: pointer; font-weight: 600;
  }
  .play-btn:hover { opacity: 0.9; }
  .sciviz-caption {
    font-family: var(--font-mono); font-size: 12px;
    letter-spacing: 0.05em; color: var(--light-fg-muted);
    margin-top: 10px; text-align: center;
  }
</style>
