---
interface Props {
  title: string;
  summary?: string;
  tags?: string[];
  image?: string;       // optional inline screenshot
  imageAlt?: string;
  asterisk?: boolean;   // show the orange asterisk before the title
}

const { title, summary, tags = [], image, imageAlt = "", asterisk = true } = Astro.props;
---

<section class="case-hero-wrap">
  <div class="case-hero">
    {image && <img src={image} alt={imageAlt} />}
  </div>

  {tags.length > 0 && (
    <div class="case-tags">
      {tags.map((t) => <span class="case-tag">{t}</span>)}
    </div>
  )}

  <h1 class="case-title">
    {asterisk && <span class="asterisk">*</span>}
    {title}
  </h1>

  {summary && (
    <p class="case-summary" set:html={summary} />
  )}
</section>
