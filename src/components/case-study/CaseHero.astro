---
interface Props {
  title: string;
  summary?: string;
  tags?: string[];
  image?: string;       // optional inline screenshot
  imageAlt?: string;
  asterisk?: boolean;   // show the orange asterisk before the title
  variant?: "card" | "embed"; // embed = no padding, no aspect ratio (for live demos)
}

const {
  title,
  summary,
  tags = [],
  image,
  imageAlt = "",
  asterisk = true,
  variant = "card",
} = Astro.props;

const hasSlot = Astro.slots.has("default");
const hasHeroContent = !!image || hasSlot;
---

<section class="case-hero-wrap">
  {hasHeroContent && (
    <div class={`case-hero ${variant === "embed" ? "case-hero--embed" : ""}`}>
      {image && <img src={image} alt={imageAlt} />}
      <slot />
    </div>
  )}

  {tags.length > 0 && (
    <div class="case-tags">
      {tags.map((t) => <span class="case-tag">{t}</span>)}
    </div>
  )}

  <h1 class="case-title">
    {asterisk && <span class="asterisk">*</span>}
    {title}
  </h1>

  {summary && (
    <p class="case-summary" set:html={summary} />
  )}
</section>
