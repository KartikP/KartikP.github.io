---
import LightLayout from "../layouts/LightLayout.astro";
import { site } from "../config/site";
---

<LightLayout title="About" section="About">
  <h1 class="page-title">About</h1>
  <p class="page-subtitle">The short version.</p>

  <div class="prose">
    <p>
      I'm <strong>{site.name}</strong> — a research scientist and engineer
      working at the intersection of neuroscience, AI, and the systems built
      to study both. Currently building
      <a href="https://www.brain-score.org" target="_blank" rel="noopener">software</a>
      at MIT SQI to quantify how brain-like artificial systems really are.
      Previously, I completed a PhD in Neuroscience, computationally modeling
      the development of stem-cell–derived neuronal networks. I'm interested
      in how minds work — biological and artificial. I like problems whose
      answers don't show up for years, infrastructure that gets more useful
      the longer it runs, and people who can hold curiosity and rigor at the
      same time. The parts of a project I look forward to most are the ones
      where building and thinking meet.
    </p>

    <p>
      Reach me at <a href={`mailto:${site.email}`}>{site.email}</a> or on
      <a href={site.social.github} target="_blank" rel="noopener">GitHub</a>.
    </p>
  </div>
</LightLayout>
