---
import { getCollection } from "astro:content";
import LightLayout from "../../layouts/LightLayout.astro";

const entries = (await getCollection("work", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short" });
---

<LightLayout title="Work" section="Work">
  <h1 class="page-title">Work</h1>
  <p class="page-subtitle">Selected case studies.</p>

  {entries.length === 0 ? (
    <p class="entry-empty">
      No case studies yet. Drop an <code>.mdx</code> file in
      <code>src/content/work/</code> to add one.
    </p>
  ) : (
    <ul class="entry-list">
      {entries.map((entry) => (
        <li>
          <a href={`/work/${entry.id}`}>
            <div>
              <div class="entry-title">{entry.data.title}</div>
              <div class="entry-desc">{entry.data.summary}</div>
            </div>
            <time class="entry-meta" datetime={entry.data.date.toISOString()}>
              {fmt(entry.data.date)}
            </time>
          </a>
        </li>
      ))}
    </ul>
  )}
</LightLayout>
