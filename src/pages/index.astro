---
import DarkLayout from "../layouts/DarkLayout.astro";
import NeuralRaster from "../components/NeuralRaster.astro";
import WhatIsThis from "../components/WhatIsThis.astro";
import { site, nav } from "../config/site";
---

<DarkLayout description={site.description}>
  <NeuralRaster />
  <WhatIsThis />

  <div class="landing-shell">
    <header class="landing-header">
      <span class="kp-mark">
        <svg
          class="kp-glyph"
          viewBox="0 0 1664 1523"
          width="18"
          height="16"
          aria-hidden="true"
          focusable="false"
        >
          <g transform="translate(-210 -10006)" stroke="currentColor" fill="currentColor">
            <g transform="matrix(1.04834,0,0,1,-11.0227,-0.892301)">
              <g transform="matrix(1.18708,0,0,1,-733.8,9732.68)">
                <g transform="matrix(0.803556,0,0,1,795.76,274.209)">
                  <path d="M152.875,1120.3C93.184,1103.21 30.843,1137.79 13.747,1197.48C-3.349,1257.17 31.233,1319.51 90.923,1336.61C150.613,1353.7 212.954,1319.12 230.05,1259.43C247.146,1199.74 212.565,1137.4 152.875,1120.3Z" />
                  <path d="M186.79,1247.04C253.627,1258.1 330.883,1261.09 401.503,1239.76C575.285,1187.27 678.04,652.975 705.655,494.689C851.054,-338.746 882.07,1091.87 1059.74,1401.62C1164.23,1583.79 1249.6,1265.08 1389.46,1202.66" fill="none" stroke-width="75" stroke-linecap="round" stroke-linejoin="round" />
                </g>
              </g>
              <g transform="matrix(0.847783,-0.458355,0.437218,0.888769,-875.698,10928.7)">
                <g transform="matrix(0.575573,0,0,0.575573,915.651,590.146)">
                  <path d="M2092.15,1382.54L2120.72,1210.27" fill="none" stroke-width="130.3" stroke-linecap="round" />
                </g>
                <g transform="matrix(-0.23792,0.524097,0.524097,0.23792,1995.81,1.64823)">
                  <path d="M2092.15,1382.54L2120.72,1210.27" fill="none" stroke-width="130.3" stroke-linecap="round" />
                </g>
              </g>
              <g transform="matrix(1.03887,0,0,-0.963027,-763.843,12347)">
                <g transform="matrix(0.918195,0,0,-1.03839,938.206,2429.91)">
                  <path d="M1450.81,986.646C1461.19,1026.72 1502.15,1050.82 1542.22,1040.44C1582.29,1030.06 1606.4,989.1 1596.02,949.03C1585.64,908.959 1544.67,884.854 1504.6,895.235C1464.53,905.615 1440.43,946.575 1450.81,986.646Z" fill="none" stroke-width="75" stroke-linejoin="miter" stroke-miterlimit="10" />
                  <path d="M1504.6,895.235C1156.62,-288.312 324.461,-121.407 158.405,972.351" fill="none" stroke-width="75" stroke-linecap="round" stroke-linejoin="round" />
                </g>
              </g>
              <g transform="matrix(-0.614408,0.764931,-0.729656,-0.644112,2683.62,10272.6)">
                <g transform="matrix(0.575573,0,0,0.575573,915.651,590.146)">
                  <path d="M2092.15,1382.54L2120.72,1210.27" fill="none" stroke-width="130.3" stroke-linecap="round" />
                </g>
                <g transform="matrix(-0.23792,0.524097,0.524097,0.23792,1995.81,1.64823)">
                  <path d="M2092.15,1382.54L2120.72,1210.27" fill="none" stroke-width="130.3" stroke-linecap="round" />
                </g>
              </g>
            </g>
          </g>
        </svg>
        {site.name}
      </span>
      <span>{site.tagline}</span>
    </header>

    <div class="landing-middle">
      <p class="landing-hero" data-reveal>{site.hero}</p>

      <nav class="landing-nav" aria-label="Main" data-reveal="1000">
        <ol>
          {nav.map((item, i) => (
            <li>
              <a href={item.href}>
                <span class="nav-title">{item.title}</span>
                <span class="nav-sub">{item.subtitle}</span>
                <span class="nav-idx">{String(i + 1).padStart(2, "0")}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>

    <footer class="landing-footer">
      <span class="landing-caption">
        Live raster of 1,000 neurons — move your cursor
      </span>
    </footer>
  </div>

  <script is:inline>
    // Element-level reveal — every [data-reveal] element fades in after a
    // delay. Default delay is HEAD_DELAY; an element can override with
    // data-reveal="<ms>" for its own timing (e.g. nav appears after hero).
    (function () {
      const HEAD_DELAY = 100;   // ms — default delay before reveal starts

      function bind() {
        const els = document.querySelectorAll("[data-reveal]");
        const reduceMotion =
          window.matchMedia &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        els.forEach(function (el) {
          if (el.__revealed) return;
          el.__revealed = true;
          if (reduceMotion) return;
          const override = el.getAttribute("data-reveal");
          const delay =
            override && !isNaN(parseFloat(override))
              ? parseFloat(override)
              : HEAD_DELAY;
          el.style.animationDelay = delay + "ms";
          el.classList.add("is-revealing");
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", bind);
      } else {
        bind();
      }
      document.addEventListener("astro:page-load", function () {
        document.querySelectorAll("[data-reveal]").forEach(function (el) {
          el.__revealed = false;
          el.classList.remove("is-revealing");
          el.style.animationDelay = "";
        });
        // Re-trigger animation by forcing a reflow before re-adding the class.
        void document.body.offsetWidth;
        bind();
      });
    })();
  </script>

  <script is:inline>
    // Spontaneous-network-burst glitch — when the raster fires a burst,
    // briefly apply a chromatic-split glitch to the nav titles. The neurons
    // that map to each link "fire" along with the burst, so the title
    // shudders and chromatic-aberrates for ~280ms with a small random
    // per-title offset.
    (function () {
      let bound = false;

      function bind() {
        if (bound) return;
        bound = true;

        const reduceMotion =
          window.matchMedia &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduceMotion) return;

        window.addEventListener("raster:burst", function (e) {
          const detail = e && e.detail ? e.detail : {};
          const intensities = detail.intensities || [];
          const links = document.querySelectorAll(".landing-nav a");

          links.forEach(function (link, i) {
            const title = link.querySelector(".nav-title");
            if (!title) return;
            const intensity =
              typeof intensities[i] === "number" ? intensities[i] : 0;
            // Skip the pulse when this link's tuned neurons barely fired.
            if (intensity < 0.06) return;

            // Map intensity → pulse strength multiplier.
            const gs = Math.min(0.4 + intensity * 2.4, 2.2);
            const offset = Math.random() * 80;

            setTimeout(function () {
              const wasActive = title.classList.contains("burst-glitch");
              title.style.setProperty("--gs", gs.toFixed(3));
              if (wasActive) {
                // Animation already running — let it finish naturally rather
                // than forcing a synchronous reflow per burst.
                return;
              }
              title.classList.add("burst-glitch");
              setTimeout(function () {
                title.classList.remove("burst-glitch");
              }, 420);
            }, offset);
          });
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", bind);
      } else {
        bind();
      }
    })();
  </script>
</DarkLayout>
