---
import { getCollection, render } from "astro:content";
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import CaseHero from "../../components/case-study/CaseHero.astro";
import MetaBar from "../../components/case-study/MetaBar.astro";
import RasterMini from "../../components/sciviz/RasterMini.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);

const toc = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ id: h.slug, label: h.text }));

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short" });

const heroTags = [fmt(project.data.date).toUpperCase()];
if (project.data.repo) heroTags.push("REPO");
if (project.data.url) heroTags.push("LIVE");

const showMeta = !!(project.data.role || project.data.team || project.data.timeline || project.data.skills.length);

const { heroImage, heroImageAlt, heroComponent } = project.data;
const heroVariant = heroComponent ? "embed" : "card";
---

<CaseStudyLayout
  title={project.data.title}
  summary={project.data.summary || project.data.description}
  accent={project.data.accent}
  toc={toc}
>
  <CaseHero
    title={project.data.title}
    summary={project.data.summary || project.data.description}
    tags={heroTags}
    image={heroImage}
    imageAlt={heroImageAlt}
    variant={heroVariant}
  >
    {heroComponent === "RasterMini" && <RasterMini height={260} neuronCount={280} />}
  </CaseHero>

  {showMeta && (
    <MetaBar
      role={project.data.role}
      team={project.data.team}
      timeline={project.data.timeline}
      skills={project.data.skills}
    />
  )}

  <article class="prose case-prose">
    <Content />
  </article>
</CaseStudyLayout>
